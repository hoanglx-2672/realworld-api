# Application Configuration
# HOST: địa chỉ app lắng nghe. Bỏ trống = mọi địa chỉ; localhost = chỉ máy này gọi được.
HOST=
PORT=3000
# Môi trường chạy: development | production | test
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=realworld
DB_PASSWORD=realworld
DB_DATABASE=realworld
# In câu SQL ra console (true/false)
DB_LOGGING=false

# Ngôn ngữ mặc định khi request không chỉ định
DEFAULT_LOCALE=en
