PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=realworld
DB_PASSWORD=realworld
DB_DATABASE=realworld
# In câu SQL ra console (true/false)
DB_LOGGING=false

# Ngôn ngữ mặc định khi request không chỉ định
DEFAULT_LOCALE=en

# JWT: secret dài, ngẫu nhiên. Tạo: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Chống dò mật khẩu: tối đa N lần POST /api/users/login mỗi IP trong TTL (ms)
LOGIN_THROTTLE_LIMIT=10
LOGIN_THROTTLE_TTL_MS=60000

# Chạy sau reverse proxy: số proxy tin cậy (vd. 1) hoặc dải IP (vd. loopback, 10.0.0.0/8).
# Bỏ trống khi app nhận request trực tiếp.
TRUST_PROXY=
